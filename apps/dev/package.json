{
  "name": "@dsh-sentry/dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 development host: boots the plugin tree programmatically or via cordis.yml.",
  "exports": {
    ".": {
      "types": "./src/bin.ts",
      "default": "./src/bin.ts"
    }
  },
  "bin": {
    "dsh-sentry-dev": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "start:loader": "tsx src/bin-loader.ts",
    "probe:session-env": "tsx src/probe-session-env.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@dsh-sentry/datasource": "workspace:*",
    "@dsh-sentry/env-matrix": "workspace:*",
    "@dsh-sentry/sentry": "workspace:*",
    "@dsh-sentry/sentry-persona": "workspace:*",
    "@dsh-sentry/sentry-skills": "workspace:*",
    "@dsh-sentry/service-alertmanager": "workspace:*",
    "@dsh-sentry/service-code-repository": "workspace:*",
    "@dsh-sentry/service-dbx": "workspace:*",
    "@dsh-sentry/service-env-provider": "workspace:*",
    "@dsh-sentry/service-greptimedb": "workspace:*",
    "@dsh-sentry/service-prometheus": "workspace:*",
    "@dsh-sentry/service-rocketmq": "workspace:*",
    "@dsh-sentry/service-trace": "workspace:*",
    "@dsh-sentry/service-zadig": "workspace:*",
    "@dsh-sentry/tool-callflow-analyzer": "workspace:*",
    "@dsh-sentry/tool-code-repository": "workspace:*",
    "@dsh-sentry/tool-db-inspector": "workspace:*",
    "@dsh-sentry/tool-log-analyzer": "workspace:*",
    "@dsh-sentry/tool-metrics-inspector": "workspace:*",
    "@dsh-sentry/tool-redis-inspector": "workspace:*",
    "@dsh-sentry/tool-trace-analyzer": "workspace:*",
    "@dsh-sentry/tool-zadig-inspector": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@dsh-sentry/env-binding": "workspace:*",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
