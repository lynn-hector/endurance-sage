{
  "name": "@dsh-sentry/ui-settings",
  "version": "0.1.6",
  "type": "module",
  "description": "Web settings section for viewing environment configuration and editing machine-local defaults and credentials in the DSH settings shell.",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@dsh-sentry/env-binding": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dsh-sentry/env-matrix": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.yeastar.com/yeastar/infrastructure/golang/endurance/dsh-sentry.git",
    "directory": "packages/web/ui-settings"
  },
  "files": [
    "dist"
  ]
}
