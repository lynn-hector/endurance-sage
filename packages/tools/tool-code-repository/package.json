{
  "name": "@dsh-sentry/tool-code-repository",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code repository tools: cross-repo search (codegraph index or ripgrep fallback), file reading, and ff-only repo sync (git pull --ff-only on configured repos, with automatic incremental codegraph reindex), as a controlled bridge past the session sandbox.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dsh-sentry/env-matrix": "workspace:*",
    "@dsh-sentry/evidence": "workspace:*",
    "@dsh-sentry/service-code-repository": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
