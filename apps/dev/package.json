{
  "name": "@dsh-sentry/dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 development host: boots the plugin tree programmatically or via cordis.yml.",
  "exports": {
    ".": {
      "types": "./src/bin.ts",
      "default": "./src/bin.ts"
    }
  },
  "bin": {
    "dsh-sentry-dev": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "start:loader": "tsx src/bin-loader.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@dsh-sentry/sentry-persona": "workspace:*",
    "@dsh-sentry/sentry-skills": "workspace:*",
    "@dsh-sentry/service-dbx": "workspace:*",
    "@dsh-sentry/service-greptimedb": "workspace:*",
    "@dsh-sentry/service-prometheus": "workspace:*",
    "@dsh-sentry/service-trace": "workspace:*",
    "@dsh-sentry/service-zadig": "workspace:*",
    "@dsh-sentry/tool-code-repository": "workspace:*",
    "@dsh-sentry/tool-db-inspector": "workspace:*",
    "@dsh-sentry/tool-hello": "workspace:*",
    "@dsh-sentry/tool-log-analyzer": "workspace:*",
    "@dsh-sentry/tool-metrics-inspector": "workspace:*",
    "@dsh-sentry/tool-redis-inspector": "workspace:*",
    "@dsh-sentry/tool-trace-analyzer": "workspace:*",
    "@dsh-sentry/tool-zadig-inspector": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
