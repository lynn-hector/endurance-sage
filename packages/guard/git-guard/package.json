{
  "name": "@dsh-sentry/guard-git",
  "version": "0.1.0",
  "type": "module",
  "description": "Pre-execute policy plugin: intercepts destructive or remote-affecting git commands in shell-executing tools (deny hard, ask for the rest).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.yeastar.com/yeastar/infrastructure/golang/endurance/dsh-sentry.git",
    "directory": "packages/guard/git-guard"
  },
  "files": [
    "dist"
  ]
}
