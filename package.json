{
  "name": "dsh-sentry-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @dsh-sentry/dev run start",
    "dev:loader": "pnpm --filter @dsh-sentry/dev run start:loader",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run dev && pnpm run dev:loader"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
