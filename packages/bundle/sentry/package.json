{
  "name": "@dsh-sentry/sentry",
  "version": "0.1.0",
  "type": "module",
  "description": "Versioned DSH bundle for the complete dsh-sentry investigator plugin set.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@dsh-sentry/cache-store": "workspace:*",
    "@dsh-sentry/callflow-store": "workspace:*",
    "@dsh-sentry/datasource": "workspace:*",
    "@dsh-sentry/db-store": "workspace:*",
    "@dsh-sentry/env-binding": "workspace:*",
    "@dsh-sentry/env-matrix": "workspace:*",
    "@dsh-sentry/evidence": "workspace:*",
    "@dsh-sentry/guard-git": "workspace:*",
    "@dsh-sentry/log-store": "workspace:*",
    "@dsh-sentry/metrics-store": "workspace:*",
    "@dsh-sentry/mq-store": "workspace:*",
    "@dsh-sentry/sentry-persona": "workspace:*",
    "@dsh-sentry/sentry-skills": "workspace:*",
    "@dsh-sentry/service-alertmanager": "workspace:*",
    "@dsh-sentry/service-code-repository": "workspace:*",
    "@dsh-sentry/service-dbx": "workspace:*",
    "@dsh-sentry/service-env-provider": "workspace:*",
    "@dsh-sentry/service-greptimedb": "workspace:*",
    "@dsh-sentry/service-prometheus": "workspace:*",
    "@dsh-sentry/service-rocketmq": "workspace:*",
    "@dsh-sentry/service-tapd": "workspace:*",
    "@dsh-sentry/service-trace": "workspace:*",
    "@dsh-sentry/service-zadig": "workspace:*",
    "@dsh-sentry/tool-callflow-analyzer": "workspace:*",
    "@dsh-sentry/tool-code-repository": "workspace:*",
    "@dsh-sentry/tool-db-inspector": "workspace:*",
    "@dsh-sentry/tool-env-switcher": "workspace:*",
    "@dsh-sentry/tool-log-analyzer": "workspace:*",
    "@dsh-sentry/tool-metrics-inspector": "workspace:*",
    "@dsh-sentry/tool-mq-inspector": "workspace:*",
    "@dsh-sentry/tool-redis-inspector": "workspace:*",
    "@dsh-sentry/tool-tapd-inspector": "workspace:*",
    "@dsh-sentry/tool-trace-analyzer": "workspace:*",
    "@dsh-sentry/tool-zadig-inspector": "workspace:*",
    "@dsh-sentry/trace-store": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.yeastar.com/yeastar/infrastructure/golang/endurance/dsh-sentry.git",
    "directory": "packages/bundle/sentry"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
