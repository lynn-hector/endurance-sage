{
  "name": "@dsh-sentry/profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development profile consuming the same aggregate sentry bundle published to GitLab Package Registry.",
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@xmanrui/dsh-im",
        "dsh-context",
        "@dsh-sentry/sentry"
      ]
    }
  },
  "dependencies": {
    "@dsh-sentry/sentry": "workspace:*",
    "@xmanrui/dsh-im": "^5.6.0",
    "dsh-context": "^0.77.0"
  }
}
