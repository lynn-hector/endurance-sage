{
  "name": "@dsh-sentry/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deployment assembly: the environment matrix renders startup/default-env profiles; runtime evidence routing is bound per DSH session.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "use-env": "tsx src/use-env.ts",
    "regenerate": "tsx src/use-env.ts dev-platform-hosted-0 --out ../profile/cordis.patch.yml",
    "clone-repos": "tsx src/clone-repos.ts"
  },
  "dependencies": {
    "@dsh-sentry/env-matrix": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
