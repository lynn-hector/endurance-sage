{
  "name": "@dsh-sentry/service-env-provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Session-routed, per-environment Provider pool with isolated Cordis service scopes.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
